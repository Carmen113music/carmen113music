<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fons"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/text_suau"
        android:textSize="16sp" />

    <!-- Botons principals a dalt: així es veuen encara que la finestra de dictat de Google tapi la part de baix -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/boto_agenda"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/boto_contorn"
            android:text="@string/obre_agenda"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="17sp" />

        <Button
            android:id="@+id/boto_historial"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/boto_contorn"
            android:text="@string/obre_historial"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Part central: es pot desplaçar si el text és llarg, així els botons de sota sempre es veuen -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/boto_parla"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/boto_rodo"
                android:contentDescription="@string/parla"
                android:elevation="6dp"
                android:padding="40dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/estat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/toca_per_parlar"
                android:textColor="@color/text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/exemple"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/escoltat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/text_suau"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Quan aquell dia ja hi ha alguna cosa: botons fixos, sempre a la vista -->
    <LinearLayout
        android:id="@+id/fila_dubte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/boto_no"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/boto_contorn"
            android:text="@string/no_deixa_ho"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <Button
            android:id="@+id/boto_si"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/boto_pastilla"
            android:text="@string/apunta_igualment"
            android:textAllCaps="false"
            android:textColor="@color/blanc"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/boto_alarmes"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/veure_alarmes"
            android:textAllCaps="false"
            android:textColor="@color/text_suau"
            android:textSize="14sp" />

        <Button
            android:id="@+id/boto_esborra_vr"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/esborra_vr"
            android:textAllCaps="false"
            android:textColor="@color/text_suau"
            android:textSize="14sp" />

        <Button
            android:id="@+id/boto_calendari"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/tria_agenda"
            android:textAllCaps="false"
            android:textColor="@color/text_suau"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
