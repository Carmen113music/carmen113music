<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Per gravar (es demana el primer cop que toques el botó) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Per baixar els kits de bateria de GitHub (no es demana: Android el dona sol) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BibliotecaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".FitxaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".EstudiActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ProjecteActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".KitsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".HistorialActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".DiagnosticActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Per compartir gravacions amb altres apps (només lectura i només a l'app triada) -->
        <provider
            android:name=".Proveidor"
            android:authorities="cat.riffs.fitxers"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
